# Copy to .env and fill in. Never commit .env. Never paste secrets into chat.

# Which surfaces to run: sim, terminal, imessage, imessage-local, telegram, telegram-direct, photon2 (comma-separated)
SURFACES=sim

# ── Photon 2.0 chat (SURFACES=photon2) ── app.beta.photon.codes → project → API keys (docs/CHANNELS.md "Photon 2.0 chat")
# Project API key (pho_sk_...) and project id (pho_prj_...). Not PHOTON_PROJECT_ID: the Photon CLI uses that for Stable.
# Check with: npm run photon2:check. Connect Photon's managed Telegram bot with: npm run photon2:telegram (no BotFather token).
PHOTON2_API_KEY=
PHOTON2_PROJECT_ID=
# Which Photon 2.0 platforms Homi answers on (default telegram,sms,imessage)
PHOTON2_PLATFORMS=telegram,sms,imessage

# ── Photon (Stable / spectrum-ts) ── app.photon.codes → project Settings
# (PROJECT_ID / PROJECT_SECRET, the names the Photon CLI scaffolder writes, also work)
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# shared | dedicated  (shared lines cannot see iMessage groups: photon-hq/spectrum-ts#217)
SPECTRUM_IMESSAGE_LINE=shared
# Only if you use Photon webhooks instead of the app.messages stream
SPECTRUM_WEBHOOK_SECRET=

# ── Telegram (see docs/CHANNELS.md) ──
# Direct Bot API (SURFACES=telegram-direct): only a @BotFather token, /setprivacy -> Disable. Check with: npm run telegram:check
# For groups use SURFACES=photon2,telegram-direct with PHOTON2_PLATFORMS=sms,imessage
# (Photon 2.0's managed bot can't send into groups: 409 SPACE_NOT_SENDABLE). Falls back to SPECTRUM_TELEGRAM_BOT_TOKEN.
TELEGRAM_BOT_TOKEN=
# on = the bot is an admin in your groups, so reactions arrive and count as votes (default off: members reply instead)
TELEGRAM_REACTIONS=
SPECTRUM_TELEGRAM_BOT_TOKEN=
# Also used by photon2 and telegram-direct to detect @mentions (else learned from the bot's handle / getMe)
TELEGRAM_BOT_USERNAME=

# ── Voice: Photon 2.0 SMS number → SIP/TLS → Retell (docs/CHANNELS.md) ──
# mock | poll | webhook
VOICE_MODE=mock
PHOTON_VOICE_NUMBER=
RETELL_API_KEY=
RETELL_AGENT_ID=
# Optional (docs/VOICE_SETUP.md): webhook mode URLs, voice, and pinned agent version
RETELL_WEBHOOK_URL=
RETELL_INBOUND_WEBHOOK_URL=
RETELL_VOICE_ID=
RETELL_AGENT_VERSION=
# Web demo only: ring REAL phones for these personas (persona=+1XXXXXXXXXX, comma-separated), e.g. WEB_REAL_CALLS=sam=+16175550123
# Needs RETELL_API_KEY, RETELL_AGENT_ID and PHOTON_VOICE_NUMBER above. Everyone else stays simulated.
WEB_REAL_CALLS=

# ── Places & weather (docs/HUNGRY_FLOW.md) ──
PLACES_PROVIDER=offline
PLACES_API_KEY=

# ── Privacy ──
# Hosted LLM fallback (Claude) is OFF unless DISABLE_HOSTED_LLM=false AND a key is set (docs/PRIVACY.md §3).
# When on, only addressed messages Homi couldn't understand are sent, redacted (plus unparsed availability replies).
# Set DISABLE_HOSTED_LLM=false to enable it for the server (npm start).
DISABLE_HOSTED_LLM=true
ANTHROPIC_API_KEY=
# Web demo / sim opt-in (npm run web, npm run sim): HOMI_LLM=on plus ANTHROPIC_API_KEY. HOMI_LLM=off always wins.
HOMI_LLM=
# Model for the LLM fallback (default claude-haiku-5-5: fast and cheap; e.g. claude-opus-5-5 for harder phrasing)
HOMI_LLM_MODEL=
RETENTION_HOURS=24
QUIET_HOURS=23-9
DEFAULT_TZ=America/New_York
# Generate with: npm run keys
DATA_KEY=
ID_SALT=

# ── Bills, pledges, album, travel (docs/BILLS.md, COMMITMENTS.md, ALBUM.md, TRAVEL.md) ──
# Public URL of this server, used for member-only album links (unset = labeled demo links)
PUBLIC_BASE_URL=
# simulated | (real provider id once integrated). Real deposits need a payment integration + participant authorization.
PAYMENTS_PROVIDER=simulated
# estimates | (real provider id once integrated). Live flight/stay search needs provider credentials.
TRAVEL_PROVIDER=estimates

# ── Runtime ──
DB_PATH=./data/wtw.db
# Encrypted album photos and other extension data
DATA_DIR=./data
PORT=8787
LOG_LEVEL=info
# Live demo only: enables the visible chat command `homi demo ff 22h` (fast-forwards the clock, announced in chat)
DEMO_MODE=false
