# Copy to .env and fill in. Never commit .env. Never paste secrets into chat.

# Which surfaces to run: sim, terminal, imessage, imessage-local, telegram (comma-separated)
SURFACES=sim

# ── Photon (Stable / spectrum-ts) ── app.photon.codes → project Settings
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# shared | dedicated  (shared lines cannot see iMessage groups: photon-hq/spectrum-ts#217)
SPECTRUM_IMESSAGE_LINE=shared
# Only if you use Photon webhooks instead of the app.messages stream
SPECTRUM_WEBHOOK_SECRET=

# ── Telegram (see docs/CHANNELS.md) ──
SPECTRUM_TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ── Voice: Photon 2.0 SMS number → SIP/TLS → Retell (docs/CHANNELS.md) ──
# mock | poll | webhook
VOICE_MODE=mock
PHOTON_VOICE_NUMBER=
RETELL_API_KEY=
RETELL_AGENT_ID=
# Optional (docs/VOICE_SETUP.md): webhook mode URLs, voice, and pinned agent version
RETELL_WEBHOOK_URL=
RETELL_INBOUND_WEBHOOK_URL=
RETELL_VOICE_ID=
RETELL_AGENT_VERSION=

# ── Places & weather (docs/HUNGRY_FLOW.md) ──
PLACES_PROVIDER=offline
PLACES_API_KEY=

# ── Privacy ──
# Hosted LLM fallback is OFF unless this is false AND a key is set (docs/PRIVACY.md §3)
DISABLE_HOSTED_LLM=true
ANTHROPIC_API_KEY=
RETENTION_HOURS=24
QUIET_HOURS=23-9
DEFAULT_TZ=America/New_York
# Generate with: npm run keys
DATA_KEY=
ID_SALT=

# ── Runtime ──
DB_PATH=./data/otto.db
PORT=8787
LOG_LEVEL=info
# Live demo only: enables the visible chat command `otto demo ff 22h` (fast-forwards the clock, announced in chat)
DEMO_MODE=false
