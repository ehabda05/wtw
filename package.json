{
  "name": "otto",
  "version": "0.1.0",
  "private": true,
  "description": "Otto: the friend who makes the plan happen, then forgets. A privacy-first group-chat planning agent on Photon.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "sim": "tsx src/cli/sim.ts",
    "keys": "tsx src/cli/keys.ts",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "eval": "node --import tsx eval/run.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chrono-node": "2.10.3",
    "luxon": "3.7.2",
    "opening_hours": "3.15.0",
    "spectrum-ts": "12.11.0"
  },
  "devDependencies": {
    "@types/luxon": "3.7.6",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "0.135.0"
  }
}
